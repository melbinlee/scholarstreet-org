# Netlify publishes the whole repo, so anything in it is a public URL unless
# listed here. The trailing ! is load-bearing: Netlify serves a matching
# static file before it consults redirect rules, and ! forces the rule to win.
#
# /news/data holds the sync script's per-article records -- the same text as
# the article pages, and a duplicate-content copy if crawled.
/CLAUDE.md          /404  404!
/scripts/*          /404  404!
/news/data/*        /404  404!
/.github/*          /404  404!

# Browsers request /favicon.ico regardless of the <link rel="icon"> tag.
/favicon.ico        /favicon.svg  200

# Consolidated into impact.html (2026-09-15): Why 25F and How It Works are now
# sections of the Impact page. Both old URLs were indexed and linked.
/why-25f.html          /impact.html#why-25f       301
/how-giving-works.html /impact.html#how-it-works  301
# Netlify served every page at its extensionless path too, so Google also
# knows these two without .html. Without these rules they 404.
/why-25f               /impact.html#why-25f       301
/how-giving-works      /impact.html#how-it-works  301
